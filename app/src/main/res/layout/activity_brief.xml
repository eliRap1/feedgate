<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_5"
        android:paddingEnd="@dimen/space_5"
        android:paddingTop="@dimen/space_6"
        android:paddingBottom="@dimen/space_6">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brief_screen_title"
            android:textAppearance="@style/TextAppearance.FeedGate.Display" />

        <TextView
            android:id="@+id/briefDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.FeedGate.Mono" />

        <TextView
            android:id="@+id/briefMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="@style/TextAppearance.FeedGate.Mono"
            android:textColor="@color/bone_faint"
            android:visibility="gone" />

        <TextView
            android:id="@+id/briefStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:accessibilityLiveRegion="polite"
            android:text="@string/brief_loading"
            android:textAppearance="@style/TextAppearance.FeedGate.Body"
            android:textColor="@color/bone_dim" />

        <LinearLayout
            android:id="@+id/briefList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:layoutAnimation="@anim/brief_layout_in"
            android:orientation="vertical" />

        <!-- The full stop. The brief ends and says so. -->
        <LinearLayout
            android:id="@+id/briefEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_7"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:background="@color/ember" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:fontFamily="sans-serif-condensed-medium"
                android:text="@string/brief_done_title"
                android:textColor="@color/bone"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/brief_done_sub"
                android:textAppearance="@style/TextAppearance.FeedGate.Caption" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
