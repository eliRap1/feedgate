<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:baselineAligned="false"
    android:minHeight="@dimen/touch_min"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_3"
    android:paddingBottom="@dimen/space_3">

    <!-- Editorial index: fixed column, quiet mono -->
    <TextView
        android:id="@+id/itemIndex"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="@color/bone_faint"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FeedGate.Body"
            android:textDirection="anyRtl" />

        <TextView
            android:id="@+id/itemSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:fontFamily="monospace"
            android:textColor="@color/bone_faint"
            android:textSize="11sp"
            android:letterSpacing="0.08" />
    </LinearLayout>
</LinearLayout>
