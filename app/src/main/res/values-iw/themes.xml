<?xml version="1.0" encoding="utf-8"?>
<!--
  Hebrew overrides: the Latin small-caps system (monospace + 0.22em
  tracking) doesn't exist for Hebrew — the mono fallback has no Hebrew
  glyphs and wide tracking shreds Hebrew words. Keep the hierarchy via
  size/color instead.
-->
<resources>
    <style name="TextAppearance.FeedGate.SectionLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/bone_faint</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.FeedGate.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/bone_faint</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="TextAppearance.FeedGate.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/bone</item>
        <item name="android:letterSpacing">0</item>
    </style>
</resources>
