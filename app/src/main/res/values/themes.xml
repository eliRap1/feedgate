<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Single committed dark theme. FeedGate is opened at night, usually right
      after a block bounced you out of a feed — it must read calm, warm and
      final, not glow like the thing it's guarding against.
    -->
    <style name="Theme.FeedGate" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>

        <item name="colorPrimary">@color/ember</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorSurface">@color/ink_raised</item>
        <item name="colorOnSurface">@color/bone</item>
        <item name="colorOnSurfaceVariant">@color/bone_dim</item>
        <item name="colorOutline">@color/hairline</item>

        <item name="materialCardViewStyle">@style/Widget.FeedGate.Card</item>
        <item name="android:textColorPrimary">@color/bone</item>
        <item name="android:textColorSecondary">@color/bone_dim</item>
    </style>

    <!-- ===== Type ===== -->

    <style name="TextAppearance.FeedGate.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif-condensed-medium</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/bone</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- Small caps-feel section labels: mono, tracked out, quiet -->
    <style name="TextAppearance.FeedGate.SectionLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/bone_faint</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.FeedGate.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/bone</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextAppearance.FeedGate.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/bone_faint</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="TextAppearance.FeedGate.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/bone_dim</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- ===== Components ===== -->

    <style name="Widget.FeedGate.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/ink_raised</item>
        <item name="strokeColor">@color/hairline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- The one ember button: enable-service CTA only -->
    <style name="Widget.FeedGate.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/ember</item>
        <item name="android:textColor">@color/ink</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-condensed-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/ember_dim</item>
    </style>

    <!-- Quiet workhorse button -->
    <style name="Widget.FeedGate.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/ink_well</item>
        <item name="android:textColor">@color/bone</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-condensed-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/hairline</item>
    </style>

    <!-- Quiet switches — checked state is information, not decoration -->
    <style name="Widget.FeedGate.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
        <item name="trackDecorationTint">@android:color/transparent</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAppearance">@style/TextAppearance.FeedGate.Body</item>
        <item name="android:paddingStart">2dp</item>
    </style>
</resources>
