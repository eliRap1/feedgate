<?xml version="1.0" encoding="utf-8"?>
<!--
  FeedGate palette — "quiet warden".
  Warm ink ground, bone text, ONE ember accent reserved for the three
  moments that matter: the enable-service CTA, an active pass, and the
  block overlay. Everything else stays quiet on purpose.
-->
<resources>
    <!-- Ground -->
    <color name="ink">#14110C</color>          <!-- window background -->
    <color name="ink_raised">#1D1914</color>   <!-- cards -->
    <color name="ink_well">#26211A</color>     <!-- inputs / tonal buttons -->
    <color name="hairline">#2E281F</color>     <!-- card strokes, dividers -->

    <!-- Text -->
    <color name="bone">#EDE5D8</color>         <!-- primary text -->
    <color name="bone_dim">#A89F8F</color>     <!-- secondary text -->
    <color name="bone_faint">#8F8674</color>   <!-- captions (still ≥4.5:1 on ink) -->

    <!-- Signal (use sparingly) -->
    <color name="ember">#E0703A</color>        <!-- THE accent -->
    <color name="ember_dim">#B85A2E</color>    <!-- pressed accent -->
    <color name="sage">#9DB48A</color>         <!-- "service running" only -->

    <!-- Switch states — deliberately quiet, ember is not for routine toggles -->
    <color name="switch_thumb_on">#EDE5D8</color>
    <color name="switch_thumb_off">#8F8674</color>
    <color name="switch_track_on">#4E4534</color>
    <color name="switch_track_off">#26211A</color>

    <!-- Overlay -->
    <color name="overlay_scrim">#F5120F0B</color>
</resources>
